# ===========================================
# BIBZ REPORT BOT - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Super Admin Telegram User ID
SUPER_ADMIN_ID=your_telegram_id

# API Configuration
API_BASE_URL=https://your-api-worker.your-subdomain.workers.dev
API_SECRET=your_shared_secret_here

# Turso Database
TURSO_URL=libsql://your-database-name.your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Optional: Web app URL (used in welcome messages)
WEB_URL=https://your-web-app.pages.dev

# Optional: Whitelist domains for anti-link
WHITELIST_DOMAIN=your-domain.pages.dev
