# ===========================================
# BIBZ REPORT API - Wrangler Secrets
# ===========================================
# Set these using: npx wrangler secret put <NAME>
# (Do NOT put these in wrangler.toml)

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# Shared secret between API and Bot
BOT_SECRET=your_shared_secret_here

# Telegram Bot Token (for OAuth verification)
BOT_TOKEN=your_bot_token_here

# Turso Database
TURSO_URL=libsql://your-database-name.your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Optional: Comma-separated allowed origins for CORS (default: *)
CORS_ORIGINS=https://your-web-app.pages.dev
